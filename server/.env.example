# ============================================================
# Mem0 VPS env — copy to .env on the VPS:  cp .env.example .env
# Single Supabase Postgres for app tables + vectors. No local postgres.
# ============================================================

# --- LLM (Muse Spark via opencode Go OpenAI-compatible gateway) ---
# Key for the gateway (or OpenAI key if OPENAI_BASE_URL is empty).
OPENAI_API_KEY=replace-with-your-gateway-or-openai-key
# Base URL of your opencode Go gateway, e.g. http://<vps-ip>:8080/v1
# Leave empty to use https://api.openai.com/v1 directly.
OPENAI_BASE_URL=

# Optional: other bundled LLM/embedder providers
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Cloud Postgres (Supabase, direct 5432, NOT 6543 pooler) ---
# Pooler 6543 breaks collection/index DDL — always use direct 5432 here.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_CONNECTION_STRING=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# VECTOR_STORE_CONNECTION_STRING=  # optional alias for SUPABASE_CONNECTION_STRING
POSTGRES_SSLMODE=require
POSTGRES_COLLECTION_NAME=memories
MEM0_EMBEDDING_MODEL_DIMS=1536
APP_DB_NAME=postgres

# Legacy local-postgres settings (unused when DATABASE_URL is set; rollback only).
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# --- Auth (generate once, keep secret) ---
# Generate with: openssl rand -base64 48  (Linux) — 16+ chars minimum.
ADMIN_API_KEY=replace-with-long-random-admin-key-min-16-chars
JWT_SECRET=replace-with-long-random-jwt-secret-min-32-chars
# Local development only. Leave false in production.
AUTH_DISABLED=false

# --- URLs (set to your VPS IP or domain) ---
DASHBOARD_URL=http://<vps-ip-or-domain>:3000
# Public API URL the dashboard calls from the browser. Must be reachable from
# YOUR browser, not from inside Docker — this is why localhost breaks on a VPS.
# The dashboard entrypoint injects this at container start (no rebuild needed).
NEXT_PUBLIC_API_URL=http://<vps-ip-or-domain>:8888

# --- Models (Muse Spark via gateway; embeddings stay OpenAI 1536 dims) ---
MEM0_DEFAULT_LLM_MODEL=muse-spark-1.3
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Anonymous telemetry. Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire into cron/systemd in production (high-write table on Supabase).
REQUEST_LOG_RETENTION_DAYS=7
